#usda 1.0
(
    defaultPrim = "W1"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "W1"
{
    over "base_link" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
        uniform float mjc:gravcomp = 1
    }

    over "body_link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link3"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link4"
    {
        uniform float mjc:gravcomp = 1
    }

    over "head_link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "head_link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "joints"
    {
        over "body_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3000
            uniform double mjc:actuatorfrcrange:max = 3000
        }

        over "body_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3000
            uniform double mjc:actuatorfrcrange:max = 3000
        }

        over "body_joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3000
            uniform double mjc:actuatorfrcrange:max = 3000
        }

        over "body_joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3000
            uniform double mjc:actuatorfrcrange:max = 3000
        }

        over "head_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3000
            uniform double mjc:actuatorfrcrange:max = 3000
        }

        over "head_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3000
            uniform double mjc:actuatorfrcrange:max = 3000
        }
    }

    def Scope "actuators"
    {
        def MjcActuator "body_joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3000
            uniform double mjc:forceRange:max = 3000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 86.172844
            rel mjc:target = </W1/joints/body_joint1>
        }

        def MjcActuator "body_joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3000
            uniform double mjc:forceRange:max = 3000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -143.23944
            uniform double mjc:ctrlRange:max = 143.23944
            rel mjc:target = </W1/joints/body_joint2>
        }

        def MjcActuator "body_joint3"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3000
            uniform double mjc:forceRange:max = 3000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -179.90874
            uniform double mjc:ctrlRange:max = 0
            rel mjc:target = </W1/joints/body_joint3>
        }

        def MjcActuator "body_joint4"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -500, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3000
            uniform double mjc:forceRange:max = 3000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -179.90874
            uniform double mjc:ctrlRange:max = 179.90874
            rel mjc:target = </W1/joints/body_joint4>
        }

        def MjcActuator "head_joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -50000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3000
            uniform double mjc:forceRange:max = 3000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -89.95437
            uniform double mjc:ctrlRange:max = 89.95437
            rel mjc:target = </W1/joints/head_joint1>
        }

        def MjcActuator "head_joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5000, -50000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3000
            uniform double mjc:forceRange:max = 3000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -89.95437
            uniform double mjc:ctrlRange:max = 89.95437
            rel mjc:target = </W1/joints/head_joint2>
        }
    }

    over "Chassis" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }

    over "Left_Arm" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }

    over "Right_Arm" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }
}
