#usda 1.0
(
    defaultPrim = "W1"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "W1"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }

    over "joints"
    {
        over "body_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 859.43665
        }

        over "body_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 859.43665
        }

        over "body_joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 859.43665
        }

        over "body_joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 859.43665
        }

        over "head_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 859.43665
        }

        over "head_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:jointFriction = 0.1
            float physxJoint:maxJointVelocity = 859.43665
        }
    }

    over "Chassis" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "Left_Arm" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "Right_Arm" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }
}

